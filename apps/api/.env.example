# JWT / CORS 等也可在此覆盖
# SECRET_KEY=eduai-dev-secret-change-me

# OpenAI 兼容大模型（对话 / 可兼作 TTS 回退）
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER_NAME=默认 OpenAI 兼容

# 知识库 Embedding（须支持 /v1/embeddings；也可在管理端「知识库 → Embedding 配置」填写）
# EMBEDDING_MODE=auto   # auto | api | hash
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# 神经 TTS
# 推荐：Edge（默认，免 Key，男女声神经音色）
TTS_ENGINE=auto
TTS_EDGE_ENABLED=1
# 可选：OpenAI 兼容语音（需单独 Key；DeepSeek 等不支持）
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
