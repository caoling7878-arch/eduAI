# 后端 API（开发时可用 Vite 代理默认 /api/v1 → :8000）
# VITE_API_BASE=/api/v1

# 可选：配置后英语陪练走 OpenAI 兼容接口；不配则使用本地情景陪练
VITE_LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_API_KEY=
VITE_LLM_MODEL=gpt-4o-mini

# 可选：神经 TTS（更自然）。不配时会先尝试后端 /api/v1/tts，再回退系统音色
# VITE_TTS_BASE_URL=https://api.openai.com/v1
# VITE_TTS_API_KEY=
# VITE_TTS_MODEL=gpt-4o-mini-tts
# VITE_TTS_VOICE=nova
