{
  "name": "eduai",
  "private": true,
  "version": "0.2.0",
  "description": "eduAI monorepo scripts",
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "dev:admin": "npm run dev --prefix apps/admin",
    "dev:api": "python3 -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --app-dir apps/api",
    "build": "npm run build --prefix apps/web",
    "build:admin": "npm run build --prefix apps/admin",
    "preview": "npm run preview --prefix apps/web",
    "geometry:demos": "python3 tools/geometry-lab/generate.py demos && npm run sync:geometry --prefix apps/web"
  },
  "engines": {
    "node": ">=18"
  }
}
